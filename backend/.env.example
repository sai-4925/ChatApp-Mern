# ==============================
# SERVER CONFIGURATION
# ==============================
PORT=5000
NODE_ENV=development

# ==============================
# DATABASE
# ==============================
MONGO_URI=mongodb://username:<password>@ac-pfzs3ji-shard-00-00.ufdyjv1.mongodb.net:27017,ac-pfzs3ji-shard-00-01.ufdyjv1.mongodb.net:27017,ac-pfzs3ji-shard-00-01.ufdghijv1.mongodb.net:28017/?ssl=true&replicaSet=atlas-308p7k-shard-0&authSource=admin&appName=Cluster0

# ==============================
# JWT AUTH
# ==============================
JWT_SECRET=Your_Secret
JWT_EXPIRES_IN=7d
JWT_REMEMBER_EXPIRES_IN=30d
JWT_COOKIE_NAME=chat_app

# ==============================
# CLOUDINARY (media uploads)
# ==============================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ==============================
# CORS / CLIENT
# ==============================
CLIENT_URL=http://localhost:5173

# ==============================
# EMAIL / SMTP
# ==============================
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_smtp_username
EMAIL_PASSWORD=your_smtp_password
EMAIL_FROM="ChatApp <no-reply@example.com>"

# ==============================
# RATE LIMITING
# ==============================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
